# Credenciais apenas para desenvolvimento local. Não reutilize em outros ambientes.
OS_DB_PASSWORD=local-os-postgres-password
JWT_ISSUER=fiap-techchallenge
JWT_AUDIENCE=fiap-techchallenge-client
# Use os mesmos valores Jwt do monólito para validar seus tokens administrativos.
JWT_SIGNING_KEY=local-development-signing-key-at-least-32-bytes
OS_ENABLE_OTLP=false
# Vazio usa a versão local gerada por scripts/bootstrap.ps1.
CHASSIS_VERSION=
