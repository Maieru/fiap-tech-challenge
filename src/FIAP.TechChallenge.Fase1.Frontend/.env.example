# O navegador usa a mesma origem. O Vite distribui os prefixos para cada API.
OS_UPSTREAM=http://localhost:8081
EXECUTION_UPSTREAM=http://localhost:8082
BILLING_UPSTREAM=http://localhost:8083
# Para usar um gateway no desenvolvimento, substitui os três upstreams:
# API_GATEWAY_UPSTREAM=https://gateway.example.com
# Hospedagem estática sem proxy: URL pública do gateway (configuração de build).
# VITE_API_GATEWAY_URL=https://gateway.example.com
# Bases completas opcionais (incluindo prefixo /api/.../v1):
# VITE_OS_API_BASE_URL=https://gateway.example.com/api/os/v1
# VITE_EXECUTION_API_BASE_URL=https://gateway.example.com/api/execution/v1
# VITE_BILLING_API_BASE_URL=https://gateway.example.com/api/billing/v1
